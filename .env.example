# Copia este archivo a .env.local y completa lo que uses.
# `npm run doctor` te dice qué falta. Para probar sin nada de esto: `npm run demo`.

# ── Sitio ────────────────────────────────────────────────────────────────────
# La URL pública, sin barra final. Sale en los enlaces de los correos y en los QR.
# Las NEXT_PUBLIC_* quedan escritas en el build: tienen que existir antes de `npm run build`.
NEXT_PUBLIC_APP_URL=https://tu-dominio.com

# ── Base de datos ────────────────────────────────────────────────────────────
# Cualquier base compatible con MongoDB: Atlas, MongoDB propio, Amazon DocumentDB
# o FerretDB (PostgreSQL). Ver docs/base-de-datos.md.
MONGODB_URI=
# Sólo si tu base pide un certificado propio (DocumentDB): ruta al .pem.
# MONGODB_CA_FILE=/ruta/global-bundle.pem
# MONGODB_POOL=10

# ── Sesiones del panel ───────────────────────────────────────────────────────
# 32 caracteres o más, única por despliegue:  openssl rand -base64 48
JWT_SECRET=

# ── Captcha (Cloudflare Turnstile) ───────────────────────────────────────────
# Obligatorio en producción: sin la llave secreta los formularios rechazan todo.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Correo ───────────────────────────────────────────────────────────────────
# resend | ses | consola. Si no se indica: resend cuando hay RESEND_API_KEY, y
# si no, consola (no envía, sólo lo anota). Ver docs/correo.md.
# CORREO_PROVEEDOR=resend
RESEND_API_KEY=
# Para registrar entregas y rebotes (sólo Resend). Se crea al dar de alta el webhook.
RESEND_WEBHOOK_SECRET=
# Con Amazon SES se usan las credenciales de AWS de más abajo.
# SES_REGION=us-east-1
# SES_CONFIGURATION_SET=

# El dominio tiene que estar verificado en tu proveedor.
EMAIL_FROM="SCD Tu País <hola@tu-dominio.com>"
# Para los envíos masivos. Si falta, se usa EMAIL_FROM.
MARKETING_EMAIL_FROM=

# ── Archivos (Amazon S3 o compatible) ────────────────────────────────────────
# Fotos de speakers, diapositivas y PDF. El bucket necesita lectura pública y
# CORS para PUT desde tu dominio. Ver docs/despliegue.md.
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_PUBLIC_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Carpeta dentro del bucket, por si lo compartes con otra edición.
# S3_PREFIX=2027
# Para Cloudflare R2, MinIO u otro servicio compatible.
# S3_ENDPOINT=https://<cuenta>.r2.cloudflarestorage.com

# ── Mapa de los correos (opcional) ───────────────────────────────────────────
# Google Static Maps. Sin esto los correos salen sin el mapa de la sede.
GOOGLE_MAPS_KEY=

# ── Detrás de un proxy o CDN ─────────────────────────────────────────────────
# De dónde sale la IP real, para limitar peticiones. Ver docs/seguridad.md.
# PROXIES_DE_CONFIANZA=1
# CABECERA_IP=cf-connecting-ip

# ── Primera cuenta de administración ─────────────────────────────────────────
# Sólo para `npm run crear-admin`. Bórralas después de usarlo.
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD=
